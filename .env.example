# Optional: leave these unset to use browser-local storage only.
# Copy this file to .env.local for local development.
# In Vercel, add the same variables under Project Settings > Environment Variables.
# Values are available in the browser bundle; Firebase API keys identify a project and are not server secrets.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional namespace used for Firestore path /artifacts/{namespace}/public/data/queue_videos
VITE_FIREBASE_NAMESPACE=streampulse-live-deck

# Optional: preselect a default Twitch channel for this deployment (leave blank for no default).
VITE_DEFAULT_TWITCH_CHANNEL=
