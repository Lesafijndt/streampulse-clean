# Optional: leave these unset to use browser-local storage only.
# Copy this file to .env.local for local development.
# In Vercel, add the same variables under Project Settings > Environment Variables.
# Values are available in the browser bundle; Firebase API keys identify a project and are not server secrets.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional namespace used for Firestore path /artifacts/{namespace}/public/data/queue_videos
VITE_FIREBASE_NAMESPACE=streampulse-live-deck


# Twitch OAuth (server-only; NEVER prefix these with VITE_)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_APP_URL=https://streampulse-clean.vercel.app
TWITCH_REDIRECT_URI=https://streampulse-clean.vercel.app/api/twitch/callback

# Required for secure Firestore sync: paste the full Firebase service-account JSON here.
# Server-only secret; never prefix with VITE_ and never commit a real value.
FIREBASE_SERVICE_ACCOUNT_JSON=
