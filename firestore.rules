rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isApprovedYediUser() {
      return request.auth != null
        && request.auth.token.yediAuthorized == true
        && request.auth.token.twitchLogin in ['2o3a', 'paim_beach_pete']
        && request.auth.token.role in ['streamer', 'moderator'];
    }

    function isModerator() {
      return isApprovedYediUser() && request.auth.token.twitchLogin == 'paim_beach_pete';
    }
    function isPersonalOwner(login) {
      return isApprovedYediUser() && request.auth.token.twitchLogin == login
        && login in ['2o3a', 'paim_beach_pete'];
    }
    match /artifacts/{appId}/public/data/user_profiles/{login} {
      allow read, create, update: if isPersonalOwner(login)
        && (!('preferences' in request.resource.data)
          || (request.resource.data.preferences is map
          && request.resource.data.preferences.keys().hasOnly([
            'activeTab', 'selectedCategory', 'mediaTypeFilter', 'sortBy',
            'searchQuery', 'isTheatreMode', 'statsExpanded', 'streamSettings'
          ])
          && (!('streamSettings' in request.resource.data.preferences)
            || (request.resource.data.preferences.streamSettings is map
              && request.resource.data.preferences.streamSettings.keys().hasOnly([
                'streamMode', 'subsOnly', 'autoPlayNext', 'allowYouTube',
                'allowTwitch', 'allowTikTok', 'maxDurationMinutes'
              ]))))));
      allow delete: if false;
    }
    // Only sessions minted by the server after a successful allowlisted Twitch OAuth login.
    // Anonymous Firebase Authentication is intentionally not accepted.
    match /artifacts/{appId}/public/data/queue_videos/{videoId} {
      allow read, create, update, delete: if isApprovedYediUser();
    }
    match /artifacts/{appId}/public/data/room_settings/{channelRoom} {
      allow read: if isApprovedYediUser() && channelRoom == '2o3a';
      allow create, update: if isModerator() && channelRoom == '2o3a';
      allow delete: if false;
    }
    // Durable stats use a separate append-only event stream. The client cannot edit or erase history.
    match /artifacts/{appId}/public/data/queue_events/{eventId} {
      allow read: if isModerator();
      allow create: if isApprovedYediUser()
        && request.resource.data.keys().hasOnly([
          'id', 'type', 'room', 'at', 'sessionId', 'mediaId', 'title',
          'requester', 'actor', 'platform', 'category', 'source'
        ])
        && request.resource.data.keys().hasAll([
          'id', 'type', 'room', 'at', 'sessionId', 'mediaId', 'title',
          'requester', 'actor', 'platform', 'category', 'source'
        ])
        && request.resource.data.id == eventId
        && request.resource.data.room == '2o3a'
        && request.resource.data.type in [
          'request_added', 'play_started', 'playback_completed',
          'track_skipped', 'track_replayed', 'vote_cast', 'request_removed'
        ]
        && request.resource.data.at is int
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 180
        && request.resource.data.requester is string
        && request.resource.data.requester.size() <= 64
        && request.resource.data.actor is string
        && request.resource.data.actor.size() <= 64
        && request.resource.data.platform is string
        && request.resource.data.category is string
        && request.resource.data.source is string;
      allow update, delete: if false;
    }
    // No other collections are accessible from web clients.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
