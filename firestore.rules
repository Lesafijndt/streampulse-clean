rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isApprovedYediUser() {
      return request.auth != null
        && request.auth.token.yediAuthorized == true
        && request.auth.token.twitchLogin in ['2o3a', 'paim_beach_pete']
        && request.auth.token.role in ['streamer', 'moderator'];
    }

    // Only sessions minted by the server after a successful allowlisted Twitch OAuth login.
    // Anonymous Firebase Authentication is intentionally not accepted.
    match /artifacts/{appId}/public/data/queue_videos/{videoId} {
      allow read, create, update, delete: if isApprovedYediUser();
    }
    match /artifacts/{appId}/public/data/room_settings/{channelRoom} {
      allow read, create, update: if isApprovedYediUser() && channelRoom == '2o3a';
      allow delete: if false;
    }
    // No other collections are accessible from web clients.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
