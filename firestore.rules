rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Public-demo rules for the StreamPulse queue only.
    // Anonymous authentication prevents unauthenticated REST access, but does NOT
    // distinguish trusted streamers/moderators from anonymous viewers.
    // Use verified Twitch auth/backend checks before using this for a production queue.
    match /artifacts/{appId}/public/data/queue_videos/{videoId} {
      allow read, create, update, delete: if request.auth != null;
    }

    // Per-channel settings persist between browsers through Firestore.
    // These demo rules permit all anonymous-authenticated clients to edit settings;
    // add verified Twitch OAuth/server-side role checks before production use.
    match /artifacts/{appId}/public/data/room_settings/{channelRoom} {
      allow read, create, update: if request.auth != null;
      allow delete: if false;
    }
  }
}
