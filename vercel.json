{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/api/twitch/login", "destination": "/api/twitch/auth?action=login" },
    { "source": "/api/twitch/logout", "destination": "/api/twitch/auth?action=logout" },
    { "source": "/api/twitch/bot-login", "destination": "/api/twitch/auth?action=bot-login" },
    { "source": "/api/twitch/bot-logout", "destination": "/api/twitch/auth?action=bot-logout" }
  ],
  "functions": {
    "api/twitch/eventsub.js": { "maxDuration": 60 },
    "api/twitch/eventsub-setup.js": { "maxDuration": 60 }
  }
}
